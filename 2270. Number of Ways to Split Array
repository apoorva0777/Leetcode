class Solution {
    public int waysToSplitArray(int[] nums) {
        long totalsum=0;
        for(int i=0;i<nums.length;i++){
            totalsum+=nums[i];
        }
        int validsplit=0;
        long leftsum =0;
        for(int i=0;i<nums.length-1;i++){
            leftsum+=nums[i];
            long rightsum=totalsum-leftsum;
            if(leftsum>=rightsum){
               validsplit++;
        }
        }
        return validsplit;
    }
}
